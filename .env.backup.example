# ==========================================
# HEIS SUITE - CONFIGURACIÓN DE BACKUPS (.env.backup)
# ==========================================
DB_NAME=heis_suite_db
MYSQL_ROOT_PASSWORD=CambiarPorPasswordRootSeguroMySQL2026!

# Proveedor Cloud: S3 (AWS / Cloudflare R2 / MinIO) o GCS (Google Cloud Storage)
CLOUD_PROVIDER=S3
BUCKET_NAME=heis-suite-backups-bucket

# Configuración S3 / Cloudflare R2 (Opcional si usas variables de entorno AWS estándar)
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui
AWS_DEFAULT_REGION=us-east-1
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Días de retención de backups locales
LOCAL_RETENTION_DAYS=7
