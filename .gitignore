# Dependencias en cualquier nivel
node_modules/
**/node_modules/

# Compilaciones
dist/
**/dist/
dist-ssr/

# Variables de entorno y credenciales (NUNCA SUBIR)
.env
**/.env
*.env
*.env.local
*.env.*.local
!*.env.example
!**/.env.example

# Archivos de scratch o temporales
scratch/
**/scratch/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/logs/*
!**/logs/.gitkeep

# Almacenamiento local y subidas
uploads/
**/uploads/*
!**/uploads/.gitkeep
backups/
**/backups/*
!**/backups/.gitkeep

# Base de datos local
*.sql
*.sqlite

# Sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
