# Dependencias en cualquier nivel
node_modules/
**/node_modules/

# Compilaciones
dist/
**/dist/
dist-ssr/

# Variables de entorno y credenciales (NUNCA SUBIR)
.env
**/.env
*.env
*.env.local
*.env.*.local
!*.env.example
!**/.env.example

# Archivos de scratch o temporales
scratch/
**/scratch/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/logs/*
!**/logs/.gitkeep

# Certificados y llaves digitales SUNAT (CRÍTICO: NUNCA SUBIR)
server/certs/*
!server/certs/.gitkeep
*.pfx
*.p12
*.pem
*.key

# Almacenamiento local y subidas
uploads/
**/uploads/*
!**/uploads/.gitkeep
backups/
**/backups/*
!**/backups/.gitkeep
server/storage/*
server/storage/**/*
!server/storage/**/.gitkeep

# Base de datos local
*.sql
*.sqlite
!server/src/migrations/*.sql
!migrar_cajas_multitenant.sql
!tools/load-testing/*.sql
!scripts/*.sql

# Sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
