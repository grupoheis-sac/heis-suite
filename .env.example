# HEIS Suite - Environment Configuration
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=heis_suite_db
DB_USER=root
DB_PASS=

# Seguridad y JWT
JWT_SECRET=heis_suite_super_secure_jwt_token_key_2026_enterprise_saas
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Microservicio SUNAT CPE (api-sunat-cpe)
SUNAT_API_URL=http://localhost:3080
SUNAT_API_KEY=heis_sunat_secret_key_2026

# Archivos y almacenamiento
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10


# --- Observabilidad Deep Healthcheck & Sentry ---
HEALTHCHECK_SECRET_TOKEN=genera_un_token_secreto_para_uptime_kuma_o_prometheus
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Alertas en Tiempo Real (Telegram Bot & WhatsApp Soporte HEIS) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SUPPORT_PHONE=
