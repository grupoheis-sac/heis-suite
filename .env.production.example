# ==========================================
# HEIS SUITE - CONFIGURACIÓN DE PRODUCCIÓN (.env.production)
# ==========================================
NODE_ENV=production
PORT=4000
IMAGE_TAG=latest

# --- Dominios permitidos por CORS (separados por coma) ---
CORS_ORIGINS=https://suite.grupoheis.com

# --- Base de Datos Transaccional MySQL 8.0 (server/src/config/db.js) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=heis_suite_prod
DB_USER=heis_app_user
DB_PASS=CambiaEstaClaveAppMySQL_2026!
DB_ROOT_PASS=CambiaEstaClaveRootMySQL_2026!
DB_POOL_MAX=30
DB_POOL_MIN=5

# --- Redis 7 (Socket.io Adapter & Rate Limiting) ---
REDIS_PASSWORD=CambiaEstaClaveRedis_2026!
REDIS_URL=redis://:CambiaEstaClaveRedis_2026!@redis:6379

# --- Seguridad JWT & Cifrado de Certificados SUNAT (.pfx) ---
# Generar con: openssl rand -hex 64
JWT_SECRET=reemplazar_con_cadena_aleatoria_de_64_bytes_hexadecimales
# Generar con: openssl rand -hex 32 (Exactamente 64 caracteres hex = 32 bytes para AES-256-GCM)
CERT_ENCRYPTION_KEY_HEX=reemplazar_con_exactamente_64_caracteres_hexadecimales_0123456789
JWT_EXPIRES_IN=8h

# --- Endpoints Web Services SUNAT / OSE (contingencyWorker.js y soapService.js) ---
SUNAT_ENTORNO=beta
SUNAT_ENDPOINT_BETA=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_ENDPOINT_PROD=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService


# --- Observabilidad Deep Healthcheck & Sentry ---
HEALTHCHECK_SECRET_TOKEN=genera_un_token_secreto_para_uptime_kuma_o_prometheus
SENTRY_DSN=https://tu_llave_publica@o000000.ingest.us.sentry.io/0000000
VITE_SENTRY_DSN=https://tu_llave_publica_frontend@o000000.ingest.us.sentry.io/0000001

# --- Alertas en Tiempo Real (Telegram Bot & WhatsApp Soporte HEIS) ---
TELEGRAM_BOT_TOKEN=1234567890:AAH_tu_token_de_botfather_aqui
TELEGRAM_ALERT_CHAT_ID=-1001234567890
WHATSAPP_API_URL=https://graph.facebook.com/v20.0/TU_PHONE_NUMBER_ID/messages
WHATSAPP_API_TOKEN=EAAG_tu_token_permanente_meta_o_evolution_api
WHATSAPP_SUPPORT_PHONE=51999888777
