# ==========================================
# HEIS SUITE - CONFIGURACIÓN DE PRODUCCIÓN (.env.production)
# ==========================================
NODE_ENV=production
TZ=America/Lima
PORT=4000

# Base de Datos Transaccional (MySQL 8)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=heis_suite_db
DB_USER=heis_user
DB_PASS=CambiarPorPasswordSeguroMySQL2026!
DB_ROOT_PASS=CambiarPorPasswordRootSeguroMySQL2026!
DB_POOL_MAX=30
DB_POOL_MIN=5

# Caché y WebSockets (Redis 7)
REDIS_PASSWORD=CambiarPorPasswordSeguroRedis2026!
REDIS_URL=redis://:CambiarPorPasswordSeguroRedis2026!@redis:6379

# Seguridad de Autenticación
JWT_SECRET=heis_suite_super_secure_jwt_token_key_2026_enterprise_saas_production_ready
JWT_EXPIRES_IN=8h

# Motor de Facturación SUNAT
SUNAT_ENTORNO=beta
SUNAT_CERT_ENCRYPTION_KEY=clave_secreta_aes256_para_certificados_pfx_32_caracteres!

# Control de Versión de Imagen de Contenedor
IMAGE_TAG=latest
